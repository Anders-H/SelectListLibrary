<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.4</Version>
    <PackageProjectUrl>https://github.com/Anders-H/SelectListLibrary</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AFL-3.0</PackageLicenseExpression>
    <PackageReleaseNotes>Moved to .NET 8.0, and better examples.</PackageReleaseNotes>
    <Title>Select List Library</Title>
    <Description>The SelectListLibrary holds controls (currently one) for letting a user select *one* item from a list. Uses Windows Forms in .NET 8.0.</Description>
    <RepositoryUrl>https://github.com/Anders-H/SelectListLibrary</RepositoryUrl>
    <PackageIcon>selectlist.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\selectlist.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
